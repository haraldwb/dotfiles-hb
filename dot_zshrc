# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Set the directory we want to store zinit and plugins
#
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi
# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in Powerlevel10k
zinit ice depth=1; zinit light romkatv/powerlevel10k

# Add in zsh plugins
zinit light Aloxaf/fzf-tab
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions

# Load completions
autoload -Uz compinit && compinit

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Keybindings
# enable vi mode in ZSH
bindkey -v

#Ensures snap binaries is added to env variables.
export PATH=$PATH:/snap/bin

#Ensures go variables are set
export GOPATH="$HOME/go/"
export PATH=$PATH:$GOPATH/bin

export RUSTPATH="$HOME/.cargo/bin"
export PATH=$PATH:$RUSTPATH

#ensure local binaries are added to path
export PATH="$HOME/.local/bin:$PATH"


# History settings
export HISTFILE=~/.zsh_history
export HISTSIZE=1000000000

# SAVEHIST is zsh's on-disk history cap. It defaults to 0, which means zsh
# writes NOTHING to HISTFILE.
SAVEHIST=200000

# saves every command before it is executed and 
# reads the history file every time history is called upon
setopt SHARE_HISTORY

# Completion styling
# make completions case-insensitive
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# set list-colors to enable filename colorizing
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# force zsh not to show completion menu, which allows fzf-tab to capture the unambiguous prefix
zstyle ':completion:*' menu no
# preview directory's content with eza when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'


## Aliases

# git
alias gp='git pull'
alias gs='git status'
alias lg='lazygit'

#chezmoi std dotfile dir
alias cdchezmoi='cd ~/.local/share/chezmoi/'
# Edit a chezmoi-managed file at its SOURCE and apply immediately, so the
# live file and the repo cannot drift apart.  Usage: cme ~/.zshrc
cme() { chezmoi edit --apply "$@"; }

### List files and folders

# Commands from https://denisrasulev.medium.com/eza-the-best-ls-command-replacement-9621252323e
# ld — lists only directories (no files)
alias ld='eza -lD'
# lh — lists only hidden files (no directories)
alias lh='eza -dl .* --group-directories-first'
# ll — lists everything with directories first
alias ll='eza -al --group-directories-first'
# ls — drop-in eza replacement; args/paths pass through, directories first
alias ls='eza -alF --color=always --group-directories-first'
# lsf — lists only files (no directories), sorted by size.
# Named lsf, not lf, which would shadow the lf file manager.
# Uses eza's own filter: piping into `grep -v '/$'` did nothing, because
# eza only appends the classify suffix when stdout is a terminal.
# --show-symlinks keeps symlinks that point at files; eza still excludes
# ones pointing at directories, which is what "no directories" should mean.
lsf() { eza -al --only-files --show-symlinks --sort=size --color=always "$@"; }
# lt — lists everything sorted by time updated
alias lt='eza -al --sort=modified'


# Set up fzf key bindings and fuzzy completion
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
# Guarded: these are not installed on every machine, and an unguarded
# eval prints "command not found" on every interactive shell there.
command -v uv     >/dev/null && eval "$(uv generate-shell-completion zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
